# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/opa"

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-32-char-secret-here"
NEXTAUTH_URL="https://opa.mecode.pro"

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-1"
AWS_S3_BUCKET="opa-media"
AWS_S3_PUBLIC_URL="https://opa-media.s3.ap-southeast-1.amazonaws.com"

# Encryption key for credentials stored in DB
# Generate with: openssl rand -hex 32  (must be exactly 64 hex chars = 32 bytes)
ENCRYPTION_KEY="your-64-char-hex-key-here"

# Cron security
# Generate with: openssl rand -hex 24
CRON_SECRET="your-cron-secret-here"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="OpaBot"

# Email (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@opa.mecode.pro"

# App
NEXT_PUBLIC_APP_URL="https://opa.mecode.pro"
